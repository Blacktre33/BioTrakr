# Compiled output must never sit next to package sources: Jest and
# ts-node resolve .js before .ts, so a stale copy silently replaces the code.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
!packages/utils/src/externals.d.ts

# Deployment secrets and data (deploy/)
deploy/.env
deploy/backups/
deploy/certs/*
!deploy/certs/.gitkeep
