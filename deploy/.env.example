# Copy to deploy/.env and fill in. Keep .env private (it holds secrets).

# Address staff type into the browser, without https:// (a name hospital IT
# points at this server, e.g. biotrakr.citygeneral.local).
BIOTRAKR_HOST=biotrakr.hospital.local

# HTTPS certificate: "internal" (Caddy's own; install its root on devices)
# or "/certs/biotrakr.crt /certs/biotrakr.key" (files from hospital IT,
# placed in deploy/certs/).
CADDY_TLS=internal

# Secrets. Make each with:   openssl rand -hex 32
# (hex only: the database password goes inside a connection address, where
# characters like / @ : would break it)
DB_PASSWORD=
JWT_SECRET=

# Optional: answer only on this server address (e.g. 10.20.0.15). Default: all.
BIND_IP=

# Backups (nightly pg_dump into BACKUP_DIR, on this server).
# BACKUP_HOUR is in the TZ time zone below.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# Strongly recommended: a second copy of every backup on another machine or
# disk, so one failed disk (or ransomware) cannot take both. A folder where
# a NAS share or USB disk is mounted on this server, e.g. /mnt/biotrakr-copy
# (see docs/DEPLOY-ONPREM.md > Backups). Once, while it is mounted, run
#   sudo touch /mnt/biotrakr-copy/.biotrakr-backup-target
# Without that file BioTrakr refuses to copy there, so a share that failed
# to mount is reported instead of quietly filling this server's own disk.
BACKUP_COPY_DIR=
# Optional monitor to ping after each good backup
BACKUP_PING_URL=
TZ=Asia/Kolkata

# Optional: urgent notices to an SMS/WhatsApp gateway (see README > Notifications)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_ESCALATE_MINUTES=15,60
# After the last escalation step, repeat every N minutes until someone
# starts the work; 0 = never
NOTIFY_ESCALATE_REPEAT_MINUTES=60

# Optional: urgent notices by email
# Mail server (the hospital's mail relay or an email provider)
SMTP_HOST=
# Port: 587 (the default) or 465
SMTP_PORT=
# true for port 465 (encrypted from the start); false (the default) for 587
SMTP_SECURE=
# Sign-in for the mail server, if it needs one (a password with $ or # in
# it goes in single quotes)
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. BioTrakr <biotrakr@citygeneral.example>
NOTIFY_EMAIL_FROM=

# Optional: urgent notices by SMS, through an SMS provider's web address
# (see docs/DEPLOY-ONPREM.md > Urgent notices for each setting and examples)
# Address to call; {to} (+9198...), {to_digits} (9198...) and {text} are
# replaced by the number and the message. Keep it in single quotes.
NOTIFY_SMS_URL=
# GET (the default) or POST
NOTIFY_SMS_METHOD=
# Request body for POST ({to} and {text} as above)
NOTIFY_SMS_BODY=
# Extra request headers, e.g. the provider's API key
NOTIFY_SMS_HEADERS=
# Wording of the message
NOTIFY_SMS_TEXT=
# Text in the provider's reply that means the message was accepted
NOTIFY_SMS_SUCCESS_MATCH=

# Optional: a monitor URL the API calls every 5 minutes while healthy, e.g.
# Uptime Kuma push or healthchecks.io; the monitor alerts you when the calls
# stop, so it catches the server itself being down
HEARTBEAT_URL=

# Preventive maintenance: open PM work orders this many days before they fall due
PM_LEAD_DAYS=14

# Repair limits (BMMP): hours to put right critical and life-saving equipment,
# and everything else; biomed is warned at three quarters of the limit.
DOWNTIME_LIMIT_CRITICAL_HOURS=72
DOWNTIME_LIMIT_OTHER_HOURS=168
# Uptime target (NHSRC: 95 district hospital, 90 CHC, 80 PHC)
UPTIME_TARGET_PERCENT=95
