# Copy to deploy/.env and fill in. Keep .env private (it holds secrets).

# Address staff type into the browser, without https:// (a name hospital IT
# points at this server, e.g. biotrakr.citygeneral.local).
BIOTRAKR_HOST=biotrakr.hospital.local

# HTTPS certificate: "internal" (Caddy's own; install its root on devices)
# or "/certs/biotrakr.crt /certs/biotrakr.key" (files from hospital IT,
# placed in deploy/certs/).
CADDY_TLS=internal

# Secrets. Make each with:   openssl rand -hex 32
# (hex only: the database password goes inside a connection address, where
# characters like / @ : would break it)
DB_PASSWORD=
JWT_SECRET=

# Optional: answer only on this server address (e.g. 10.20.0.15). Default: all.
BIND_IP=

# Backups (nightly pg_dump into BACKUP_DIR; copy that folder off the server).
# BACKUP_HOUR is in the TZ time zone below.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# Optional monitor to ping after each good backup
BACKUP_PING_URL=
TZ=Asia/Kolkata

# Optional: urgent notices to an SMS/WhatsApp gateway (see README > Notifications)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_ESCALATE_MINUTES=15,60
